# Fichero de ejemplo de variables de entorno.
# Copiar este fichero a un .env y ajustar los valores según el entorno local.

# Orígenes permitidos para CORS. Lista separada por comas si hay varios.
CORS_ORIGINS=["http://localhost:3000"]

# Base de datos (debe coincidir con las variables del docker-compose)
DATABASE_URL=postgresql+asyncpg://admin:admin@localhost:5432/korrijodb

# SMTP (Mailpit en local — docker compose up -d)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@korrijo.local

# Magic link
MAGIC_LINK_EXPIRATION_MINUTES=15
APP_BASE_URL=http://localhost:3000

# Sesión — OBLIGATORIO: cambiar por un valor secreto real
SESSION_SECRET_KEY=cambia-esto-por-un-secreto-seguro
SESSION_COOKIE_NAME=korrijo_session
SESSION_MAX_AGE_DAYS=30