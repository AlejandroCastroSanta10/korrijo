# Fichero de ejemplo de variables de entorno.
# Copiar este fichero a un .env y ajustar los valores según el entorno local.

# Orígenes permitidos para CORS. Lista separada por comas si hay varios.
CORS_ORIGINS=["http://localhost:3000"]

# Base de datos (debe coincidir con las variables del docker-compose)
DATABASE_URL=postgresql+asyncpg://admin:admin@localhost:5432/korrijodb

# SMTP (Mailpit en local)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@korrijo.com
# Email donde llegan los mensajes del formulario de contacto
CONTACT_RECIPIENT_EMAIL=acs@gmail.com
# Rate limiting del formulario de contacto (por IP)
CONTACT_RATE_LIMIT_MAX=3
CONTACT_RATE_LIMIT_WINDOW_MINUTES=10

# Magic link
MAGIC_LINK_EXPIRATION_MINUTES=15
APP_BASE_URL=http://localhost:3000

# Sesión
SESSION_SECRET_KEY=secreto123
SESSION_COOKIE_NAME=korrijo_session
SESSION_MAX_AGE_DAYS=30

# Ollama / pipeline. Poner los que se quiera usar y se tengan descargados
OLLAMA_BASE_URL=http://localhost:11434
PIPELINE_LLM_MODEL=qwen3:8b
PIPELINE_VLM_MODEL=qwen3-vl:latest
# Ventana de contexto (tokens). Subir si UN examen excede el contexto disponible.
PIPELINE_LLM_NUM_CTX=16384
PIPELINE_VLM_NUM_CTX=16384
# Timeout (segundos) de la llamada al proveedor de servicios. Subir si el modelo tarda más para UN examen.
PIPELINE_LLM_TIMEOUT=300
PIPELINE_VLM_TIMEOUT=300

# Solo para la estructuración de la rúbrica, no aplica a la corrección de exámenes
PIPELINE_LLM_THINK=false
 