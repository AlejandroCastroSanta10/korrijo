# Fichero de ejemplo de variables de entorno.
# Copiar este fichero a un .env y ajustar los valores según el entorno local.

# Orígenes permitidos para CORS. Lista separada por comas si hay varios.
CORS_ORIGINS=["http://localhost:3000"]

# Base de datos (debe coincidir con las variables del docker-compose)
DATABASE_URL=postgresql+asyncpg://admin:admin@localhost:5432/korrijodb